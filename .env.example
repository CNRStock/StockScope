# EODHD market data API key
EODHD_API_KEY=your_api_key_here

# Required for the free SEC EDGAR fundamentals fallback
SEC_USER_AGENT=AssetSeek your-email@example.com

# Optional: enables the cited AI layer on the comparative research page.
# The evidence brief still works without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional port
PORT=3000

# Production hardening
NODE_ENV=development
API_RATE_LIMIT=120
EXPENSIVE_RATE_LIMIT=20
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
PRIVATE_BETA=false
BETA_UNLIMITED=false
BETA_USERNAME=beta
BETA_PASSWORD=choose_a_long_random_password

# Supabase browser-safe project configuration (never use the service-role key here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Stripe subscriptions (test mode first). Keep secret/service-role keys server-side.
BILLING_ENABLED=false
APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_recurring_price_here
